{
  "$schema": "https://raw.githubusercontent.com/binarylinuxx/dots/main/schemas/manifest.schema.json",
  "schema": 1,
  "type": "theme",
  "id": "dev.blxshell.tokyo-night",
  "name": "Tokyo Night",
  "version": "1.0.0",
  "description": "The Tokyo Night colour scheme for the whole shell and Ghostty, with a wallpaper in its palette. Palette: Tokyo Night by enkia (github.com/enkia/tokyo-night-vscode-theme).",
  "authors": [
    {
      "name": "binarylinuxx",
      "url": "https://github.com/binarylinuxx"
    }
  ],
  "license": "MIT",
  "repository": "https://github.com/binarylinuxx/dots-themes",
  "tags": [
    "dark",
    "colour scheme",
    "neon",
    "blue",
    "night",
    "wallpaper"
  ],
  "previews": [
    "preview.jpg"
  ],
  "project": "blxshell",
  "blxshell": ">=0.1.0",
  "compositors": [
    "any"
  ],
  "wallpaper": "wallpaper.png",
  "colours": {
    "kind": "static",
    "roles": {
