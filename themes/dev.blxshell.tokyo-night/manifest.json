      "surface": "#1a1b26",
      "surfaceContainerLow": "#16161e",
      "surfaceContainer": "#24283b",
      "surfaceContainerHigh": "#292e42",
      "surfaceContainerHighest": "#414868",
      "surfaceVariant": "#414868",
