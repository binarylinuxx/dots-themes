{
  "$schema": "https://raw.githubusercontent.com/binarylinuxx/dots/main/schemas/manifest.schema.json",
  "schema": 1,
  "type": "theme",
  "id": "dev.blxshell.everforest",
  "name": "Everforest",
  "version": "1.0.0",
  "description": "The Everforest colour scheme for the whole shell and Ghostty, with a wallpaper in its palette. Palette: Everforest by sainnhe (github.com/sainnhe/everforest).",
  "authors": [
    {
      "name": "binarylinuxx",
      "url": "https://github.com/binarylinuxx"
    }
  ],
  "license": "MIT",
  "repository": "https://github.com/binarylinuxx/dots-themes",
  "tags": [
    "dark",
    "colour scheme",
    "green",
    "forest",
    "soft",
    "wallpaper"
  ],
  "previews": [
    "preview.jpg"
  ],
  "project": "blxshell",
  "blxshell": ">=0.1.0",
  "compositors": [
    "any"
